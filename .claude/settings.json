{
  "model": "opusplan",
  "enabledMcpjsonServers": [
    "context7",
    "playwright"
  ],
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/update-check.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking for studio updates..."
          }
        ]
      }
    ]
  }
}
