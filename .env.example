# Copy to .env and fill in. .env is never committed.
# Claude reads these from your system environment (PC) or the cloud environment's
# variables (claude.ai/code > environment settings) — not from the .env file itself.

# n8n — leave blank for docs/validation only (safe). Fill in to let Claude build workflows.
# Use a TEST instance or test project first, never straight on live order workflows.
N8N_API_URL=
N8N_API_KEY=

# Google Workspace MCP (only if the project uses Google). OAuth client from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Stripe: no key needed. Sign in with OAuth via /mcp and choose sandbox.
